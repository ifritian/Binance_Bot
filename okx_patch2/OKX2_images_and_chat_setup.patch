         return False, f"В тексте есть шаблонные ИИ-фразы: {', '.join(found)}"
 
     return True, ""
+
+
+def generate_chart_for_post(theme: str) -> Optional[Path]:
+    """Возвращает путь к PNG-графику для темы, БЕЗ водяного знака
+    BINANCE (см. chart_generator._draw_watermark) - график для чужой
+    площадки не должен выглядеть как скриншот с Binance.
+
+    Для темы 'market' (несколько тикеров в корзине) строим график по
+    первому тикеру корзины как представительный - тащить график сразу
+    по нескольким активам сюда не нужно, OKX-пост и так даёт разбивку
+    текстом.
+
+    Отдельный filename_suffix='_okx' - чтобы не перезаписывать график,
+    который в это же время мог генерироваться для Binance Square по
+    тому же тикеру (main.py дёргает форматы в одном процессе).
+    Возвращает None, если график построить не удалось - вызывающий код
+    (main.try_publish_okx_orbit_draft) в этом случае просто шлёт
+    черновик без картинки, а не пропускает публикацию целиком.
+    """
+    ticker = THEMES[theme]["tickers"][0]
+    return generate_chart_image(ticker, days=2, watermark_text=None, filename_suffix="_okx")
